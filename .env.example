# Copy to .env.local and fill in. Every variable is explained in docs/settings-and-env.md.

# ── Database ────────────────────────────────────────────────────────────────
# Runtime connection. Must use the bisonops_app role (pnpm db:setup creates it).
# On Neon, use the pooled connection string.
# The bisonops_app password must be 16 characters or more.
DATABASE_URL=postgres://bisonops_app:CHANGE_ME_16_CHARS_MIN@localhost:5432/bisonops
# Schema owner, for migrations only. Never used by the running app.
DATABASE_MIGRATE_URL=postgres://bisonops_owner:CHANGE_ME@localhost:5432/bisonops
DATABASE_POOL_MAX=5

# ── Auth ────────────────────────────────────────────────────────────────────
# clerk in production. dev gives a seeded people picker (refused on Vercel production).
AUTH_PROVIDER=dev
DEV_AUTH_SECRET=any-long-random-string-for-local-only
# Set to 1 only to run the dev sign-in under `next start` on your machine (end-to-end tests).
# Never runs on Vercel, whatever this says.
ALLOW_DEV_AUTH=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# ── Billing (Bison Ops billing tenants) ─────────────────────────────────────
# fake grants items directly so the unlock flow works without Stripe. Refused on Vercel production.
BILLING_PROVIDER=fake
ALLOW_FAKE_BILLING=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SALES=
STRIPE_PRICE_MARKETING=
STRIPE_PRICE_ASSISTANT=
STRIPE_PRICE_CALCULATOR=
STRIPE_PRICE_CONFIGURATOR=
STRIPE_PRICE_KNOWLEDGE_BASE=
STRIPE_PRICE_GALLERY=
STRIPE_PRICE_TRANSLATION=
STRIPE_PRICE_PUSH=
STRIPE_PRICE_CONTACT_SHARING=

# ── Secrets at rest ─────────────────────────────────────────────────────────
# Comma-separated version:base64key pairs (32 bytes each). New writes use SECRETS_ACTIVE_KEY.
# Make one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEYS=1:REPLACE_WITH_32_BYTE_BASE64_KEY
SECRETS_ACTIVE_KEY=1

# ── Page agent ──────────────────────────────────────────────────────────────
# Marketing > Pages builds pages with Claude when this is set. Leave it empty to
# use the offline stand-in, which follows short, direct requests only.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=

# ── Email (Marketing) ───────────────────────────────────────────────────────
# One Resend account sends for every company, each from its own verified domain.
# Without a key nothing sends; Marketing still builds and saves.
RESEND_API_KEY=
# Signing secret (whsec_...) of the Resend webhook at /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=
# Optional. A From on a domain verified in Bison Ops' own Resend account, used
# only for tests before a company's domain is verified.
EMAIL_FALLBACK_FROM=
# Optional. stand-in keeps email in memory (outbox at /api/dev/outbox). Local only.
EMAIL_PROVIDER=

# ── Jobs ────────────────────────────────────────────────────────────────────
# Vercel Cron sends this as a bearer token to /api/cron/daily. Use the same
# token for /api/cron/email, every 5 minutes (Vercel Pro or an outside scheduler).
CRON_SECRET=

# ── App ─────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
