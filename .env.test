# Used by `pnpm test` and `pnpm test:e2e`. Local throwaway values only; safe to commit.
# The test database is wiped and re-seeded on every run.
DATABASE_URL=postgres://bisonops_app:app_password_local_only_0001@localhost:5432/bisonops_test
DATABASE_MIGRATE_URL=postgres://bisonops_owner:owner@localhost:5432/bisonops_test
DATABASE_POOL_MAX=4
AUTH_PROVIDER=dev
ALLOW_DEV_AUTH=1
DEV_AUTH_SECRET=test-only-dev-auth-secret-not-for-real-use
BILLING_PROVIDER=fake
ALLOW_FAKE_BILLING=1
STRIPE_WEBHOOK_SECRET=whsec_test_only_secret
STRIPE_PRICE_SALES=price_test_sales
STRIPE_PRICE_MARKETING=price_test_marketing
STRIPE_PRICE_ASSISTANT=price_test_assistant
STRIPE_PRICE_CALCULATOR=price_test_calculator
SECRETS_KEYS=1:hF3o6LrQ0dW9GzjXtEhJFoO2mM0LEqUrFWH40T/IRFQ=
SECRETS_ACTIVE_KEY=1
CRON_SECRET=test-cron-secret
APP_URL=http://localhost:3100
CLERK_WEBHOOK_SIGNING_SECRET=whsec_IMZWAAYddtzx0CV2VPWG/AbwbMiC8SfF

# The page agent uses the offline stand-in in tests, never Claude.
PAGE_AGENT=stand-in

# Email goes to an in-memory outbox in tests, never out.
EMAIL_PROVIDER=stand-in
